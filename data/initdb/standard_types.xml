<?xml version="1.0" encoding="UTF-8"?>
<a:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://arolios.org/arolios/model ./xam.xsd"
	xmlns:a="http://arolios.org/arolios/model">
	<domain name="std">

        <primitive name="integer" native="integer"/>
		<primitive name="bigint" native="bigint"/>
        <primitive name="smallint" native="smallint"/>
		<primitive name="boolean" native="boolean"/>
		<primitive name="decimal" native="numeric"/>
		<primitive name="real" native="real"/>
		<primitive name="doubleprecision" native="double precision"/>
		<primitive name="charstring" native="character varying"/>
		<primitive name="text" native="text"/>
		<primitive name="date" native="date"/>
		<primitive name="time" native="time"/>
		<primitive name="timestamp" native="timestamp"/>
		<primitive name="timetz" native="time with time zone"/>
		<primitive name="timestamptz" native="timestamp with time zone"/>

        <type name="mlangcharstring">
			<property name="fr" type="charstring"/>
			<property name="en" type="charstring"/>
        </type>
        <type name="mlangtext">
			<property name="fr" type="text"/>
			<property name="en" type="text"/>
        </type>
	</domain>
</a:model>
