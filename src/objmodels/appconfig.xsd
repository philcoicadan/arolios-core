<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://arolios.org/arolios/model"
	xmlns:t="http://arolios.org/arolios/model"
	elementFormDefault="unqualified">
	<xsd:annotation>
		<xsd:documentation xml:lang="en">
		Schema to define the application configuration
		Version 0.1
		Copyright 2022 Philippe Coicadan. All rights reserved.
		</xsd:documentation>
	</xsd:annotation>

	<!--  global definitions -->
	<xsd:element name="appConfig" type="t:App_config_c"/>

	<xsd:complexType name="App_config_c">
		<xsd:sequence>
			<xsd:element name="domain" type="t:Domain_c" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
        <xsd:attribute name="type" type="t:Config_type_c" default="collectionProperties"/>
	</xsd:complexType>	

    <xsd:simpleType name="Config_type_c">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="collectionProperties"/>
		</xsd:restriction>
	</xsd:simpleType>	  
		
	<xsd:complexType name="Element_c">
        <xsd:attribute name="name" type="xsd:NCName" use="required"/> 
	</xsd:complexType>
	

	<xsd:complexType name="Domain_c">
		<xsd:complexContent>
			<xsd:extension base="t:Element_c">
				<xsd:sequence>
					<xsd:choice maxOccurs="unbounded">
						<xsd:element name="class" type="t:Class_c" minOccurs="0" maxOccurs="unbounded"/>
						<xsd:element name="association" type="t:Classifier_c" minOccurs="0" maxOccurs="unbounded"/>	
					</xsd:choice>
				</xsd:sequence>
			</xsd:extension>	
		</xsd:complexContent>
	</xsd:complexType>
	

    <xsd:complexType name="Classifier_c">
		<xsd:complexContent>
			<xsd:extension base="t:Element_c">
				<xsd:sequence>
					<xsd:element name="property" type="xsd:NCName" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>	
		</xsd:complexContent>	
	</xsd:complexType>


	<xsd:complexType name="Class_c">
		<xsd:complexContent>
			<xsd:extension base="t:Classifier_c">
				<xsd:sequence>
					<xsd:element name="memberEnd" type="xsd:NCName" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>			
			</xsd:extension>	
		</xsd:complexContent>
	</xsd:complexType>




</xsd:schema>
