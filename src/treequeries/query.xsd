<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://arolios.org/arolios/tqry"
	xmlns:t="http://arolios.org/arolios/tqry"
	elementFormDefault="unqualified">
	<xsd:annotation>
		<xsd:documentation xml:lang="en">
		Schema defining queries for exporting data
		</xsd:documentation>
	</xsd:annotation>

	<!--  global definitions -->
	<xsd:element name="query" type="t:XML_query_t"/>

	<xsd:complexType name="XML_query_t">
        <xsd:sequence>
            <xsd:element name="parameter" type="xsd:NCName" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:choice maxOccurs="1">
                    <xsd:element name="class" type="t:XML_query_class_t" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="association" type="t:XML_query_association_t" minOccurs="0" maxOccurs="1"/>
            </xsd:choice>
		</xsd:sequence>
        <xsd:attribute name="name" type="xsd:NCName" use="required" />
	</xsd:complexType>	

		  

	<xsd:attributeGroup name="classifier_attrs">
		<xsd:attribute name="name" type="xsd:NCName" use="required"/> 
		<xsd:attribute name="domain" type="xsd:NCName" use="required" />
	</xsd:attributeGroup>

    <xsd:complexType name="XML_query_base_t">
		<xsd:sequence>
			<xsd:element name="property" type="xsd:NCName" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="filter" type="xsd:string" minOccurs="0" maxOccurs="1"/>
		</xsd:sequence>
	</xsd:complexType>


	<xsd:complexType name="XML_query_base_class_t">
		<xsd:complexContent>
			<xsd:extension base="t:XML_query_base_t">
				<xsd:sequence>
                    <xsd:element name="memberEnd" type="t:XML_query_member_end_t" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

    <xsd:complexType name="XML_query_class_t">
		<xsd:complexContent>
			<xsd:extension base="t:XML_query_base_class_t">
                <xsd:attributeGroup ref="t:classifier_attrs"/>
			</xsd:extension>

		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="XML_query_association_t">
		<xsd:complexContent>
			<xsd:extension base="t:XML_query_base_t">
				<xsd:sequence>
					<xsd:element name="memberEnd" type="t:XML_query_member_end_t" minOccurs="1" maxOccurs="2"/>
				</xsd:sequence>
                <xsd:attributeGroup ref="t:classifier_attrs"/>
			</xsd:extension>	
		</xsd:complexContent>
	</xsd:complexType>
	
    <xsd:complexType name="XML_query_member_end_t">
        <xsd:sequence>
            <xsd:element name="association" type="t:XML_query_base_t" minOccurs="0" maxOccurs="1" />
            <xsd:element name="class" type="t:XML_query_base_class_t" minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
        <xsd:attribute name="name" type="xsd:NCName" use="required"/> 
	</xsd:complexType>

 


</xsd:schema>
